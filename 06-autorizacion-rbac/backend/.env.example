# ──────────────────────────────────────────────────────────────────────────
# Módulo 06 — Autorización RBAC · variables de entorno (todas opcionales en dev)
#
# En desarrollo el backend corre SIN .env: config.py tiene defaults 'development'.
# En producción (ENVIRONMENT=production) estas variables SON obligatorias:
# ──────────────────────────────────────────────────────────────────────────

# "development" (default) | "production" | "testing"
ENVIRONMENT=development

# OBLIGATORIA en producción. Generala con: openssl rand -hex 32
SECRET_KEY=

# Expiración del access token en minutos (default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"demo@ejemplo.com\", \"password\": \"demo12345\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "pm.test('login ok', function(){ pm.response.to.have.status(200); });"

    {
      "name": "8 · Rate Limiting + Security Headers (Nivel 02)",
      "item": [
        {
          "name": "8.1 · 5 intentos fallidos (email: bruteforce@ejemplo.com)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"bruteforce@ejemplo.com\", \"password\": \"incorrecta\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/jwt/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "jwt",
                "login"
              ]
            },
            "description": "Correlo 6 veces seguidas en el Collection Runner: las primeras 5 dan 401, la sexta da 429 Too Many Requests (rate limit: 5 fallos / 15 min por email)."
          },
          "response": []
        },
        {
          "name": "8.2 · 6º intento -> 429 (rate limit activo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"bruteforce@ejemplo.com\", \"password\": \"incorrecta\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/jwt/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "jwt",
                "login"
              ]
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "pm.test('429 con Retry-After', function(){ pm.response.to.have.status(429); pm.expect(pm.response.headers.get('Retry-After')).to.not.be.empty; });"
                  ]
                }
              }
            ]
          },
          "response": []
        },

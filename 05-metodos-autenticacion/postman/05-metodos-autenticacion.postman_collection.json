                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "var j = pm.response.json(); pm.collectionVariables.set('token_opaco', j.access_token);",
                    "pm.test('token opaco recibido', function(){ pm.response.to.have.status(200); pm.expect(j.access_token).to.not.be.empty; });"
                  ]
                }
              }
            ]
          },
          "response": []

# ─────────────────────────────────────────────────────────────
# Configuración del Módulo 04 — Autenticación y Seguridad
# ─────────────────────────────────────────────────────────────

# PostgreSQL — la MISMA base de los módulos anteriores.
# La tabla `users` se crea sola al arrancar (create_all).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ─────────────────────────────────────────────────────────────
# Seguridad JWT
# ─────────────────────────────────────────────────────────────
# La clave con la que se FIRMAN los tokens. En producción esto es
# un secreto que NO se versiona y se genera con:
#     openssl rand -hex 32
# Si se filtra, cualquiera puede fabricar tokens válidos.
SECRET_KEY=dev-secret-cambiar-en-produccion

# Algoritmo de firma del JWT (HMAC con SHA-256).
ALGORITHM=HS256

# Cuánto vive un token antes de expirar (en minutos).
ACCESS_TOKEN_EXPIRE_MINUTES=30
